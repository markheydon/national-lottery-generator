{
    "name": "markheydon/national-lottery-generator",
    "type": "project",
    "description": "A PHP application that analyses UK National Lottery historical data and generates playful number suggestions using file-based storage.",
    "keywords": ["lottery", "national-lottery", "number-generator", "uk-lottery"],
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
