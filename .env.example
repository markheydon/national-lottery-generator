# Lottery Application Configuration

# LOTTERY_DOWNLOAD_TIMEOUT: Timeout in seconds for downloading CSV files from National Lottery website
# Default: 30 seconds. Increase if downloads are timing out.
LOTTERY_DOWNLOAD_TIMEOUT=30

# LOTTERY_BACKUP_MAX: Number of timestamped CSV backups to keep per game (default 5)
# LOTTERY_BACKUP_MAX=5

# Optional test overrides for CSV download URLs (used by PHPUnit)
# LOTTERY_DOWNLOAD_URL_LOTTO=
# LOTTERY_DOWNLOAD_URL_EUROMILLIONS=
# LOTTERY_DOWNLOAD_URL_THUNDERBALL=
# LOTTERY_DOWNLOAD_URL_SET_FOR_LIFE=
