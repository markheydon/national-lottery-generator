{
    "name": "National Lottery Generator",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24"
        }
    },
    "containerEnv": {
        "COMPOSER_MEMORY_LIMIT": "-1",
        "COMPOSER_VENDOR_DIR": "/home/vscode/.composer-vendor",
        "XDEBUG_MODE": "off"
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "PHP built-in server",
            "onAutoForward": "openPreview"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-vendor,target=/home/vscode/.composer-vendor,type=volume",
        "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "remoteUser": "vscode"
}
