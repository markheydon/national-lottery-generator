{
    "name": "National Lottery Generator",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:2": {
            "version": "24"
        },
        "ghcr.io/helpers4/devcontainer/playwright-dev:1": {
            "browsers": "chromium",
            "installDeps": false
        }
    },
    "runArgs": [
        "--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777"
    ],
    "containerEnv": {
        "COMPOSER_MEMORY_LIMIT": "-1",
        "COMPOSER_VENDOR_DIR": "/home/vscode/.composer-vendor",
        "XDEBUG_MODE": "off"
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "PHP built-in server",
            "onAutoForward": "openPreview"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-vendor,target=/home/vscode/.composer-vendor,type=volume",
        "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
    "onCreateCommand": "bash -c 'for dir in \"$COMPOSER_VENDOR_DIR\" node_modules; do if [[ -d \"$dir\" && ! -w \"$dir\" ]]; then sudo chown -R \"$(id -u):$(id -g)\" \"$dir\"; fi; done'",
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "remoteUser": "vscode"
}